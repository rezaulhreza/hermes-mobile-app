+def _notify_push(req: ServerRequest) -> None:
+    """Tell the phone a human is being waited on, off-thread and best-effort.
+
+    ``send`` blocks on ``req.event.wait`` right after this returns, so a push made inline would
+    delay the prompt it announces. The service spawns its own daemon thread and never raises;
+    this guard is the last line so a bad config read cannot break the request either.
+    """
+    try:
+        from hermes_cli.push import service as push_service
+        push_service.notify_request(req.method, req.sid, req.params)
+    except Exception:
+        logger.debug("push: notify skipped for %s", req.method, exc_info=True)
+
+
