+def _notify_mention_push(sid: str, profile: str, message: Any, author: Any = None) -> bool:
+    """Phone push when an inbound chat message addresses the owner as ``@user``.
+
+    The inbound delivery path (this module's mailbox poll) is where a message becomes a turn; this
+    fires beside that, off-thread (the push service spawns its own daemon thread), and swallows
+    every failure so a push can never affect the delivery. Returns whether a push was dispatched.
+    """
+    try:
+        from hermes_cli.push import service as push_service
+        if not push_service.mentions_owner(message):
+            return False
+        sender = str((author or {}).get("name") or "") if isinstance(author, dict) else ""
+        return push_service.notify_mention(sid, profile=profile or "", sender=sender, text=message)
+    except Exception:
+        logging.getLogger(__name__).debug("push: mention notify skipped", exc_info=True)
+        return False
+
