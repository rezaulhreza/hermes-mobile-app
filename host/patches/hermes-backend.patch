--- a/tools/read_preview_tool.py
+++ b/tools/read_preview_tool.py
@@ -5,21 +5,102 @@ The preview's content lives in the renderer (a sandboxed ``<webview>``), so this
 round-trips through the gateway's blocking-prompt bridge like ``read_terminal``
 (``preview.read.request`` -> ``preview.read.respond``). Registered as action=read of
 `desktop_preview`; the agent dispatches here with the injected callback.
+
+A phone has no scriptable guest: its pane shows the page in a cross-origin frame it
+cannot read, so it answers ``unreadable`` with the address. This module then fetches
+that address through ``web_extract`` — the tool the agent would otherwise have to
+reach for itself — so a read on the phone returns the page's text rather than a note
+that invites a retry the gateway pays its whole deadline for.
 """
 
+import json
 from typing import Callable, Optional
 
 from tools.read_terminal_tool import read_pane
 
+# Mirrors PREVIEW_READ_MAX_CHARS in apps/desktop/src/app/chat/right-rail/preview-reader.ts:
+# the cap the pane applies to one read, so a gateway fetch pages the same way.
+_READ_MAX_CHARS = 24_000
+
+_GATEWAY_READ_NOTE = ("Read on the gateway, not from the pane: this device shows the page in a "
+                      "cross-origin frame it cannot read, so the address was fetched instead.")
+
+
+def _as_object(raw) -> dict:
+    """``registry.dispatch`` answers with a JSON string; tolerate a dict too."""
+    if isinstance(raw, dict):
+        return raw
+    try:
+        parsed = json.loads(raw)
+    except (TypeError, ValueError):
+        return {}
+    return parsed if isinstance(parsed, dict) else {}
+
+
+def _gateway_page(message: dict, start: int, count: int) -> Optional[str]:
+    """Fetch a paneless device's page text. None when this is not that case.
+
+    ``web_extract`` owns the fetch policy (its own SSRF boundary, its own refusal of
+    URLs that carry secrets), so this adds no new fetch surface: it reuses the tool
+    the agent already has.
+    """
+    if not message.get("unreadable"):
+        return None
+    url = message.get("url")
+    if not isinstance(url, str) or not url.startswith(("http://", "https://")):
+        return None
+
+    from tools.registry import registry  # late: the registry imports every tool module
+
+    payload = _as_object(registry.dispatch("web_extract", {"urls": [url], "char_limit": _READ_MAX_CHARS}))
+    entries = payload.get("results")
+    entry = entries[0] if isinstance(entries, list) and entries and isinstance(entries[0], dict) else {}
+    text = entry.get("content") if isinstance(entry.get("content"), str) else ""
+    title = entry.get("title") or message.get("title") or url
+
+    if not text:
+        # Say why, and keep the pane's own note: on the phone it names the way round.
+        why = entry.get("error") or payload.get("error") or "it returned no text"
+        note = " ".join(part for part in (message.get("note"), f"The gateway could not read it either: {why}") if part)
+        return json.dumps({
+            "kind": "url", "url": url, "title": title, "note": note,
+            "start": 0, "end": 0, "text": "", "total_chars": 0,
+        }, ensure_ascii=False)
+
+    total = len(text)
+    begin = max(0, min(start, total))
+    want = min(max(1, count), _READ_MAX_CHARS)
+    return json.dumps({
+        "end": min(begin + want, total),
+        "kind": "url",
+        "note": _GATEWAY_READ_NOTE,
+        "start": begin,
+        "text": text[begin:begin + want],
+        "title": title,
+        "total_chars": total,
+        "url": url,
+    }, ensure_ascii=False)
+
 
