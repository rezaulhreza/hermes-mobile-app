+"""APNs device-registration routes for the Hermes iOS app.
+
+The phone registers its device token here once, after the user grants notification permission,
+and forgets it on sign-out. The routes sit behind the dashboard's existing auth gate (like every
+other ``/api`` route), so they add no auth scheme of their own; the token is validated for shape
+before it is stored, because a malformed token would be re-sent to Apple on every push forever.
+"""
+
+from __future__ import annotations
+
+import logging
+
+from fastapi import APIRouter, HTTPException
+from starlette.concurrency import run_in_threadpool
+
+from hermes_cli.push import devices as store
+from hermes_cli.web_models import PushAnswerRequest, PushRegisterRequest
+
+log = logging.getLogger("hermes_cli.web_server")
+
+router = APIRouter()
+
+_VALID_ENVIRONMENTS = ("production", "sandbox")
+_APPROVAL_CHOICES = ("once", "session", "always", "deny")
+
+
+def _validate(body: PushRegisterRequest) -> tuple[str, str]:
+    """Return ``(token, environment)`` or raise a 422 the app can show."""
+    token = (body.token or "").strip()
+    if not store.is_valid_token(token):
+        raise HTTPException(status_code=422, detail="token must be 64 hex characters")
+    environment = (body.environment or "production").strip().lower()
+    if environment not in _VALID_ENVIRONMENTS:
+        raise HTTPException(status_code=422, detail="environment must be production or sandbox")
+    return store.normalize_token(token), environment
+
+
+@router.post("/api/push/register")
+async def register_push_device(body: PushRegisterRequest):
+    """Store (or refresh) this device's token. ``{"unregister": true}`` forgets it instead."""
+    token, environment = _validate(body)
+    if body.unregister:
+        removed = await run_in_threadpool(store.remove_device, token)
+        return {"ok": True, "removed": removed}
+    record = await run_in_threadpool(
+        lambda: store.register_device(
+            token, environment=environment, platform=(body.platform or "ios").strip() or "ios",
+            profile=(body.profile or "").strip(), label=(body.label or "").strip()))
+    # Echo nothing sensitive: the token is a capability, so only its prefix ever leaves here.
+    return {"ok": True, "token_prefix": store.token_prefix(record["token"]),
+            "environment": record["environment"], "profile": record["profile"]}
+
+
+@router.delete("/api/push/register")
+async def delete_push_device(body: PushRegisterRequest):
+    """Forget a device (idempotent). The token is still validated so junk is refused."""
+    token, _environment = _validate(body)
+    removed = await run_in_threadpool(store.remove_device, token)
+    return {"ok": True, "removed": removed}
+
+
+def _approval_respond(session_id: str, choice: str) -> dict:
+    """The gateway's answer to ``approval.respond`` for this session, as its JSON-RPC envelope."""
+    from tui_gateway import server
+    return server.handle_request({
+        "jsonrpc": "2.0", "id": "push-answer", "method": "approval.respond",
+        "params": {"session_id": session_id, "choice": choice}}) or {}
+
+
+@router.post("/api/push/answer")
+async def answer_from_push(body: PushAnswerRequest):
+    """Answer the approval a push announced, with no socket: a phone that iOS wakes for a button
+    of the notification has seconds and no live connection. The answer goes through the gateway's
+    own ``approval.respond``, so it is the same answer the chat screen gives."""
+    session_id = (body.session_id or "").strip()
+    choice = (body.choice or "").strip().lower()
+    if not session_id:
+        raise HTTPException(status_code=422, detail="session_id is required")
+    if choice not in _APPROVAL_CHOICES:
+        raise HTTPException(status_code=422, detail="choice must be once, session, always or deny")
+
+    answer = await run_in_threadpool(_approval_respond, session_id, choice)
+    if "error" in answer:
+        # The approval is gone (answered elsewhere, or the turn ended): the phone says so.
+        raise HTTPException(status_code=409, detail=str((answer["error"] or {}).get("message") or "no approval waits"))
+    resolved = (answer.get("result") or {}).get("resolved")
+    if not resolved:
+        # Nothing waited: answered on another device, timed out, or the turn was stopped.
+        raise HTTPException(status_code=409, detail="no approval waits in this session")
+    return {"ok": True, "resolved": resolved}
