{
  "expo": {
    "name": "Hermes",
    "slug": "hermes-native",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "hermes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.hermesnative"
    },
    "android": {
      "package": "com.example.hermesnative",
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F4",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#F8F7F4", "image": "./assets/images/icon.png", "imageWidth": 96 }],
      "expo-secure-store"
    ],
    "experiments": { "typedRoutes": true }
  }
}
